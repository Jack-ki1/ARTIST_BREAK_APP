# Copy this file to .env and configure values for your environment.
# SQLite is the local default; PostgreSQL URLs are also supported.
DATABASE_URL=sqlite:///./data/breakout_radar.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Set a maintainer contact URL or email before deploying the MusicBrainz integration.
MUSICBRAINZ_CONTACT=https://github.com/Jack-ki1/ARTIST_BREAK_APP/issues
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key across restarts/backups; saved provider credentials cannot be decrypted without it.
# Conservative default below YouTube's standard 100 search.list calls/day.
YOUTUBE_SEARCH_DAILY_BUDGET=80
MAX_PROVIDER_CALLS_PER_SEARCH=100
MAX_SCHEDULED_PROVIDER_CALLS_PER_CYCLE=100
PROVIDER_SECRETS_KEY=
